{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagent-x.dev/schemas/memory-record.schema.json",
  "title": "MemoryRecord",
  "description": "Project/user knowledge record with provenance. Secrets and sensitive personal data must never be stored as memory.",
  "type": "object",
  "required": ["memory_id", "domain", "type", "content", "status", "created_at", "visibility"],
  "additionalProperties": false,
  "properties": {
    "memory_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": ["string", "null"], "description": "null only for user-domain memories; project memories are ACL-scoped" },
    "domain": { "enum": ["project", "user", "knowledge", "execution", "task"] },
    "type": { "enum": ["decision", "fact", "preference", "procedure", "artifact_summary"] },
    "content": { "type": "string", "minLength": 3 },
    "source_refs": { "type": "array", "items": { "type": "string" }, "description": "e.g. artifact:uuid, task:uuid, doc:span" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["candidate", "verified", "superseded", "rejected"], "description": "candidate memories are never trusted as facts; promotion requires evidence" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "visibility": { "enum": ["private", "project", "team"] }
  }
}
